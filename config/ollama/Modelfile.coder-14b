# Modelfile.coder-14b — primary coding model recipe.
#
# Built on top of Qwen2.5-Coder-14B-Instruct (Q4_K_M). Inherits the
# shared coding system prompt and tunes sampling for deterministic-ish
# code generation.
#
# Create with:
#   ollama create coder-14b -f config/ollama/Modelfile.coder-14b
#
# Reference: docs/04-models.md (sampling defaults section).

FROM qwen2.5-coder:14b-instruct-q4_K_M

SYSTEM """$(cat config/ollama/PROMPT.coding.md)"""

# Sampling — conservative for code. Lower temperature = more deterministic.
PARAMETER temperature        0.2
PARAMETER top_p              0.95
PARAMETER top_k              40
PARAMETER repeat_penalty     1.05
PARAMETER num_ctx            8192
PARAMETER stop               "<|im_end|>"
PARAMETER stop               "<|endoftext|>"

# `keep_alive` is no longer a valid Modelfile PARAMETER in Ollama 0.32.x.
# The server-side default is set in /etc/systemd/system/ollama.service.d/override.conf
# via OLLAMA_KEEP_ALIVE=10m. Per-request override is also available via
# the API. This block is intentionally left as a comment for grep.