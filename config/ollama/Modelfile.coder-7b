# Modelfile.coder-7b — fast secondary coding model recipe.
#
# Same persona as coder-14b but on the smaller 7 B model. Use for quick
# autocompletion-style prompts where latency matters more than depth.
#
# Create with:
#   ollama create coder-7b -f config/ollama/Modelfile.coder-7b

FROM qwen2.5-coder:7b-instruct-q4_K_M

SYSTEM """$(cat config/ollama/PROMPT.coding.md)"""

PARAMETER temperature        0.2
PARAMETER top_p              0.95
PARAMETER top_k              40
PARAMETER repeat_penalty     1.05
PARAMETER num_ctx            8192
PARAMETER stop               "<|im_end|>"
PARAMETER stop               "<|endoftext|>"

# `keep_alive` is no longer a valid Modelfile PARAMETER in Ollama 0.32.x.
# Server-side default is set in /etc/systemd/system/ollama.service.d/override.conf
# via OLLAMA_KEEP_ALIVE=10m.