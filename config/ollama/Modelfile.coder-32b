# Modelfile.coder-32b — large coding model recipe (partial offload).
#
# Uses Qwen2.5-Coder-32B-Instruct (Q4_K_M). On the RTX 3060 (12 GB) this
# cannot fit fully in VRAM; Ollama will keep the layers that fit on GPU
# and offload the rest to CPU/RAM. Expect noticeably lower tokens/s than
# coder-14b; use only when the larger context window or stronger reasoning
# is worth the cost.
#
# Create with:
#   ollama create coder-32b -f config/ollama/Modelfile.coder-32b

FROM qwen2.5-coder:32b-instruct-q4_K_M

SYSTEM """$(cat config/ollama/PROMPT.coding.md)"""

PARAMETER temperature        0.2
PARAMETER top_p              0.95
PARAMETER top_k              40
PARAMETER repeat_penalty     1.05
# Smaller context by default to keep VRAM/RAM pressure manageable.
PARAMETER num_ctx            4096
PARAMETER stop               "<|im_end|>"
PARAMETER stop               "<|endoftext|>"

# `keep_alive` is no longer a valid Modelfile PARAMETER in Ollama 0.32.x.
# Server-side default is set in /etc/systemd/system/ollama.service.d/override.conf
# via OLLAMA_KEEP_ALIVE=10m.