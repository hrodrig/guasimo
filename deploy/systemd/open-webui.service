[Unit]
Description=Open WebUI (ia-lab)
After=ollama.service
Wants=ollama.service

[Service]
Type=simple
User=ia-lab
Group=ia-lab
WorkingDirectory=/opt/ia-lab
Environment="DATA_DIR=/data/open-webui"
Environment="WEBUI_AUTH=false"
Environment="OPENAI_API_BASE_URL=http://127.0.0.1:11434/v1"
Environment="OLLAMA_BASE_URL=http://127.0.0.1:11434"
Environment="PORT=8080"
Environment="HOST=127.0.0.1"
ExecStart=/opt/ia-lab/webui-venv/bin/open-webui serve
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data /var/log/ia-lab /opt/ia-lab
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target