[Unit]
Description=Open WebUI (guasimo)
After=ollama.service
Wants=ollama.service

[Service]
Type=simple
User=guasimo
Group=guasimo
WorkingDirectory=/opt/guasimo
Environment="DATA_DIR=/data/open-webui"
Environment="WEBUI_AUTH=false"
Environment="OPENAI_API_BASE_URL=http://127.0.0.1:11434/v1"
Environment="OLLAMA_BASE_URL=http://127.0.0.1:11434"
Environment="DEFAULT_MODELS=qwen3-27b"
Environment="PORT=8080"
Environment="HOST=127.0.0.1"
ExecStart=/opt/guasimo/webui-venv/bin/open-webui serve
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data /var/log/guasimo /opt/guasimo
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target