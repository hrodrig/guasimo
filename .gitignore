# Whitelist-style .gitignore.
#
# Everything is ignored by default. Only the paths re-allowed below are
# tracked. To add a new file or directory, add a `!` rule here first —
# there is no implicit allow-list.
#
# Rule of thumb:
#   *            ignore every name at every depth (still descends)
#   .*           ignore every dotfile
#   !/file       re-allow a specific file at the repo root
#   !/dir/       re-allow a directory entry at the root
#   !/dir/**     re-allow everything inside that directory, recursively
#
# Do NOT use `/*` as the top-level ignore: it anchors at the root and
# stops git from descending into subdirectories, so the `!` rules below
# can never match and everything stays hidden.

# --- Ignore everything --------------------------------------------------

*
.*

# --- Re-allow: root files ----------------------------------------------

!/LICENSE
!/README.md
!/SPECIFICATIONS.md
!/CHANGELOG.md
!/.gitignore
!/.editorconfig

# --- Re-allow: tracked directories -------------------------------------

!/config/
!/config/**

!/deploy/
!/deploy/**

!/docs/
!/docs/**

!/scripts/
!/scripts/**

!/tests/
!/tests/**

!/models/
!/models/**

# --- Re-ignore inside whitelisted directories --------------------------
# Last matching pattern wins, so these close holes opened by !/dir/**.

# Model weights and binary blobs — never tracked.
*.gguf
*.ggml
*.bin
*.safetensors

# Secrets.
config/**/.env
config/**/.env.*

# macOS metadata.
**/.DS_Store

# Benchmark output is transient; keep only the placeholder.
tests/bench-results/**
!tests/bench-results/.gitkeep
